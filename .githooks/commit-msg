#!/bin/sh
# Rejects commit messages that are not Conventional Commits. See .claude/rules/git-workflow.md.

subject=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -n 1)

# Messages git or GitHub write themselves
case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types='feat|fix|perf|refactor|style|docs|test|build|ci|chore|revert'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [^A-Z[:space:]].*[^.]$"; then
  echo "✖ Commit message is not a Conventional Commit:" >&2
  echo "    $subject" >&2
  echo "  Expected: <type>(<scope>): <lowercase summary, no final period>" >&2
  echo "  Types: $types" >&2
  echo "  See .claude/rules/git-workflow.md" >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "✖ Commit summary is ${#subject} characters; keep it to 72." >&2
  exit 1
fi
